<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>TextHelper</Title>
    <Version>1.2.1</Version>
    <Authors>AdriansRepos</Authors>
    <Description>Knihovna pro validované zadávání vstupů od uživatele v konzolových aplikacích, s automatickým opakováním dotazu při neplatném vstupu.</Description>
    <PackageProjectUrl>https://github.com/AdriansRepos/TextHelper</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdriansRepos/TextHelper</RepositoryUrl>
    <AssemblyVersion>1.2.1</AssemblyVersion>
    <FileVersion>1.2.1</FileVersion>
    <PackageReleaseNotes>Oprava chybného názvu balíčku v příkazu pro instalaci.</PackageReleaseNotes>
	  
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
